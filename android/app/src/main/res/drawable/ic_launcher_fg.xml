<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: a satellite fix being questioned.

     A vector, deliberately. The previous attempt pointed the manifest at
     mipmap PNGs generated by a script that hardcoded one developer's machine
     paths — and .gitignore excludes *.png, so those files could never have
     been committed at all. The build worked on exactly one laptop and failed
     for everybody else with "resource mipmap/ic_launcher not found".

     XML is carried by git, scales to every density with no generation step,
     and cannot drift from the source it was made from. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Signal arcs coming down from above, the way GPS arrives. -->
    <path
        android:strokeColor="#F0A52E"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M40,34 A18,18 0 0 1 68,34" />
    <path
        android:strokeColor="#F0A52E"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M34,26 A28,28 0 0 1 74,26" />

    <!-- The vehicle's own position: a solid, trustworthy mark. -->
    <path
        android:fillColor="#35C7E8"
        android:pathData="M54,46 L66,74 L54,68 L42,74 Z" />

    <!-- The claimed position, offset — the gap is the whole product. -->
    <path
        android:strokeColor="#FF5C4D"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,58 L78,84" />
    <path
        android:fillColor="#FF5C4D"
        android:pathData="M78,80 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
