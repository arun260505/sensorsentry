<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon with its background baked in.

     Adaptive icons (mipmap-anydpi-v26 + a <adaptive-icon> element) would be
     the modern way, but they need a mipmap folder per density to fall back to
     on older launchers. This is one file that works everywhere from API 26 up,
     which is the whole range this app supports. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F1C25" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_fg"
        android:gravity="center" />
</layer-list>
